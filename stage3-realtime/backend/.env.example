OPENAI_API_KEY=sk-...
HOST=0.0.0.0
PORT=8001
FRONTEND_URL=http://localhost:3001
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_teacher

# 봇/스캐너 차단용 쉐어드 시크릿 (랜덤 32자+ 권장)
# 미설정 시 인증 비활성 (로컬 개발 편의). 운영 환경에서는 반드시 설정.
# 프론트의 NEXT_PUBLIC_API_SECRET과 같은 값으로 맞춰야 함.
API_SHARED_SECRET=

# Supabase A — 학생 정보 조회용
SUPABASE_STUDENT_URL=https://xxxx.supabase.co
SUPABASE_STUDENT_KEY=eyJ...
SUPABASE_STUDENT_TABLE=students

# Supabase B — 카카오 트리거용 (INSERT 시 카톡 자동 발송)
# 미설정 시 카톡 발송 비활성
SUPABASE_KAKAO_URL=https://yyyy.supabase.co
SUPABASE_KAKAO_KEY=eyJ...
SUPABASE_KAKAO_TABLE=             # 트리거 테이블명
